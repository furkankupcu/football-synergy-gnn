 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# 04 — ML Modelleri\n", "Stil kümeleme + maç sonucu tahmini."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys; sys.path.insert(0, '..')\n",
    "from dotenv import load_dotenv; load_dotenv('../.env')\n",
    "\n",
    "from src import db\n",
    "from src.analysis import style, tactical\n",
    "from src.viz.style_plots import style_scatter\n",
    "\n",
    "LEAGUE, SEASON = 'Süper Lig', '2024-2025'\n",
    "team_stats = db.get_team_stats(league=LEAGUE, season=SEASON)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## PCA + K-Means Kümeleme"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "clustered = style.cluster_teams(team_stats)\n",
    "print('Küme sayısı:', clustered['cluster'].nunique())\n",
    "clustered[['team_name', 'cluster', 'PC1', 'PC2']].sort_values('cluster')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = style_scatter(clustered, team_col='team_name')\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Her küme için ortalama profil\n",
    "for cid in sorted(clustered['cluster'].unique()):\n",
    "    teams_in_cluster = clustered[clustered['cluster'] == cid]['team_name'].tolist()\n",
    "    print(f'Küme {cid}: {teams_in_cluster}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Maç Tahmini\n",
    "Bu kısım fikstür/maç sonuçları gerektirir — şu an PostgreSQL'de henüz bu tablo yok. "
    "FBref schedule scrapinginden sonra burayı çalıştırın."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Çoklu lig stil kümeleme (tüm liglerdeki takımları aynı uzayda göster)\n",
    "all_teams = db.get_team_stats(season=SEASON)\n",
    "print(f'{len(all_teams)} takım, {all_teams[\"league\"].nunique()} lig')\n",
    "all_clustered = style.cluster_teams(all_teams, n_clusters=6)\n",
    "fig = style_scatter(all_clustered, team_col='team_name')\n",
    "fig.show()"
   ]
  }
